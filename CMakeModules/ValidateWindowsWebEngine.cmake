# Shared configure/install preflight. A missing path must never turn the
# compositor synchronization fix into an optional packaging feature.
function(tigerest_validate_webengine runtime qt_version source_root)
  if(NOT IS_DIRECTORY "${runtime}")
    message(FATAL_ERROR "Set TIGEREST_WEBENGINE_RUNTIME to the verified patched QtWebEngine runtime directory (see dev/windows/qtwebengine/README.md)")
  endif()
  if(NOT EXISTS "${runtime}/tigerest-webengine.json")
    message(FATAL_ERROR "Patched WebEngine build manifest is missing")
  endif()
  file(READ "${runtime}/tigerest-webengine.json" runtime_manifest)
  string(JSON runtime_version GET "${runtime_manifest}" qtVersion)
  string(JSON expected_core_hash GET "${runtime_manifest}" coreSha256)
  if(NOT runtime_version STREQUAL "${qt_version}")
    message(FATAL_ERROR "WebEngine runtime ${runtime_version} does not match Qt ${qt_version}")
  endif()
  foreach(name Qt6WebEngineCore.dll Qt6WebEngineQuick.dll
               Qt6WebEngineQuickDelegatesQml.dll QtWebEngineProcess.exe)
    if(NOT EXISTS "${runtime}/bin/${name}")
      message(FATAL_ERROR "Incomplete patched WebEngine runtime: ${name}")
    endif()
  endforeach()
  foreach(dir resources translations qml)
    if(NOT IS_DIRECTORY "${runtime}/${dir}")
      message(FATAL_ERROR "Incomplete patched WebEngine runtime: ${dir}")
    endif()
  endforeach()
  # The runtime must be built from exactly the patches in patches.txt, in order.
  set(patch_directory "${source_root}/dev/windows/qtwebengine")
  file(STRINGS "${patch_directory}/patches.txt" patch_names REGEX "[^ \t]")
  list(LENGTH patch_names patch_count)
  string(JSON manifest_patch_count ERROR_VARIABLE manifest_patch_error
         LENGTH "${runtime_manifest}" patches)
  if(manifest_patch_error OR patch_count EQUAL 0 OR NOT manifest_patch_count EQUAL patch_count)
    message(FATAL_ERROR "Patched WebEngine patch set does not match dev/windows/qtwebengine/patches.txt")
  endif()
  set(patch_files)
  set(patch_index 0)
  foreach(patch_name IN LISTS patch_names)
    string(STRIP "${patch_name}" patch_name)
    string(JSON manifest_patch_name GET "${runtime_manifest}" patches ${patch_index} file)
    string(JSON expected_patch_hash GET "${runtime_manifest}" patches ${patch_index} sha256)
    file(SHA256 "${patch_directory}/${patch_name}" patch_hash)
    string(TOLOWER "${expected_patch_hash}" expected_patch_hash)
    if(NOT manifest_patch_name STREQUAL patch_name OR NOT patch_hash STREQUAL expected_patch_hash)
      message(FATAL_ERROR "Patched WebEngine source patch does not match its build manifest: ${patch_name}")
    endif()
    list(APPEND patch_files "${patch_directory}/${patch_name}")
    math(EXPR patch_index "${patch_index} + 1")
  endforeach()
  file(SHA256 "${runtime}/bin/Qt6WebEngineCore.dll" core_hash)
  string(TOLOWER "${expected_core_hash}" expected_core_hash)
  if(NOT core_hash STREQUAL expected_core_hash)
    message(FATAL_ERROR "Patched WebEngine DLL does not match its build manifest")
  endif()
  set(TIGEREST_WEBENGINE_CORE_SHA256 "${core_hash}" PARENT_SCOPE)
  set(TIGEREST_WEBENGINE_PATCH_FILES "${patch_files}" PARENT_SCOPE)
endfunction()
