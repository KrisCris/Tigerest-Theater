+
+ScriptPromise<ImageBitmap> ImageBitmap::CreateEncodedAsync(
+    ImageElementBase* image,
+    std::optional<gfx::Rect> crop_rect,
+    ScriptState* script_state,
+    scoped_refptr<base::SequencedTaskRunner> task_runner,
+    ExceptionState& exception_state,
+    const ImageBitmapOptions* options) {
+  scoped_refptr<Image> input = image->CachedImage()->GetImage();
+  DCHECK(input->IsBitmapImage());
+  auto parsed = std::make_unique<ParsedOptions>(
+      ParseOptions(options, crop_rect, image->BitmapSourceSize()));
+  if (DstBufferSizeHasOverflow(*parsed)) {
+    exception_state.ThrowDOMException(DOMExceptionCode::kInvalidStateError,
+                                     "The ImageBitmap could not be allocated.");
+    return EmptyPromise();
+  }
+  // The DOM resource and its mutable SharedBuffer stay on the original thread.
+  // Copy encoded bytes, options, orientation and origin status at call time.
+  Vector<char> encoded = input->HasData()
+      ? input->Data()->CopyAs<Vector<char>>() : Vector<char>();
+  if (encoded.empty()) {
+    exception_state.ThrowDOMException(DOMExceptionCode::kInvalidStateError,
+                                     "The source image could not be decoded.");
+    return EmptyPromise();
+  }
+  const bool premultiply_alpha = parsed->premultiply_alpha;
+  const bool color_space_conversion = parsed->has_color_space_conversion;
+  const bool high_bit_depth =
+      input->PaintImageForCurrentFrame().GetColorType() == kRGBA_F16_SkColorType;
+  auto* resolver = MakeGarbageCollected<ScriptPromiseResolver<ImageBitmap>>(
+      script_state, exception_state.GetContext());
+  auto promise = resolver->Promise();
+  worker_pool::PostTask(
+      FROM_HERE,
+      CrossThreadBindOnce(
+          &DecodeBitmapOnWorker, std::move(encoded), premultiply_alpha,
+          high_bit_depth, color_space_conversion, std::move(task_runner),
+          CrossThreadBindOnce(&ResolveEncodedPromiseOnOriginalThread,
+                              MakeUnwrappingCrossThreadHandle(resolver),
+                              !image->WouldTaintOrigin(), std::move(parsed),
+                              input->CurrentFrameOrientation().Orientation())));
+  return promise;
+}
+
+void ImageBitmap::ResolveEncodedPromiseOnOriginalThread(
+    ScriptPromiseResolver<ImageBitmap>* resolver,
+    bool origin_clean,
+    std::unique_ptr<ParsedOptions> parsed,
+    ImageOrientationEnum orientation,
+    sk_sp<SkImage> frame) {
+  DCHECK(IsMainThread());
+  if (!resolver->GetScriptState()->ContextIsValid())
+    return;
+  scoped_refptr<StaticBitmapImage> image;
+  if (frame) {
+    parsed->source_is_unpremul = frame->alphaType() == kUnpremul_SkAlphaType;
+    image = CropImageAndApplyColorSpaceConversion(
+        UnacceleratedStaticBitmapImage::Create(std::move(frame), orientation),
+        *parsed);
+  }
+  if (!image) {
+    resolver->Reject(MakeGarbageCollected<DOMException>(
+        DOMExceptionCode::kInvalidStateError,
+        "The source image could not be decoded."));
+    return;
+  }
+  image->SetOriginClean(origin_clean);
+  resolver->Resolve(MakeGarbageCollected<ImageBitmap>(std::move(image)));
+}
