+namespace {
+void DecodeBitmapOnWorker(
+    Vector<char> encoded,
+    bool premultiply_alpha,
+    bool high_bit_depth,
+    bool color_space_conversion,
+    scoped_refptr<base::SequencedTaskRunner> task_runner,
+    WTF::CrossThreadOnceFunction<void(sk_sp<SkImage>)> callback) {
+  DCHECK(!IsMainThread());
+  auto decoder = ImageDecoder::Create(
+      SegmentReader::CreateFromSkData(
+          SkData::MakeWithoutCopy(encoded.data(), encoded.size())), true,
+      premultiply_alpha ? ImageDecoder::kAlphaPremultiplied
+                        : ImageDecoder::kAlphaNotPremultiplied,
+      high_bit_depth ? ImageDecoder::kHighBitDepthToHalfFloat
+                     : ImageDecoder::kDefaultBitDepth,
+      color_space_conversion ? ColorBehavior::kTag : ColorBehavior::kIgnore,
+      cc::AuxImage::kDefault, Platform::GetMaxDecodedImageBytes());
+  auto frame = decoder ? ImageBitmap::GetSkImageFromDecoder(std::move(decoder))
+                       : nullptr;
+  PostCrossThreadTask(*task_runner, FROM_HERE,
+                      CrossThreadBindOnce(std::move(callback), std::move(frame)));
+}
