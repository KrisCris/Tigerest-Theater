     if (!window)
         return false;
 
+#if defined(Q_OS_MACOS)
+    // Qt's indexed display IDs are not CoreGraphics display IDs. Without the
+    // actual native ID Chromium falls back to its default 60 Hz timer.
+    int64_t vsyncDisplayId = display::kInvalidDisplayId;
+    if (QScreen *screen = window->screen()) {
+        const QPoint center = screen->geometry().center();
+        CGDirectDisplayID displayId = kCGNullDirectDisplay;
+        uint32_t count = 0;
+        if (CGGetDisplaysWithPoint(CGPointMake(center.x(), center.y()), 1,
+                                   &displayId, &count) == kCGErrorSuccess && count)
+            vsyncDisplayId = displayId;
+    }
+    // If mapping fails (for example during display removal), discard the old
+    // display link and let Chromium use its normal fallback until the next update.
+    m_uiCompositor->SetVSyncDisplayID(vsyncDisplayId);
+#endif
+
