+// The offscreen ui::Compositor has no output surface reporting vsync, so viz
+// ticks its synthetic BeginFrameSource at the 60 Hz default regardless of the
+// display. Feed it the period (and on Windows the DWM vblank timebase) of the
+// screen hosting the view, refreshed periodically to follow drift and moves.
+void RenderWidgetHostViewQt::updateVSyncParameters()
+{
+    static const bool enabled = qEnvironmentVariable("TIGEREST_WEBENGINE_VSYNC") != QLatin1String("0");
+    QWindow *window = m_delegate ? m_delegate->Window() : nullptr;
+    if (!enabled || !window || !window->screen() || !window->handle())
+        return;
+    if (!m_vsyncTimer.IsRunning())
+        m_vsyncTimer.Start(FROM_HERE, base::Seconds(1),
+                           base::BindRepeating(&RenderWidgetHostViewQt::updateVSyncParameters,
+                                               base::Unretained(this)));
+    const qreal hz = window->screen()->refreshRate();
+    base::TimeTicks timebase;
+    base::TimeDelta interval;
+#if defined(Q_OS_WIN)
+    const WId id = window->winId();
+    if (!m_vsyncProvider || m_vsyncWindow != id) {
+        m_vsyncProvider = std::make_unique<gl::VSyncProviderWin>(reinterpret_cast<gfx::AcceleratedWidget>(id));
+        m_vsyncWindow = id;
+    }
+    // DWM timing describes the primary display; on a screen with another rate
+    // keep only that screen's period.
+    if (m_vsyncProvider->GetVSyncParametersIfAvailable(&timebase, &interval) && hz > 1
+        && std::abs(interval.InSecondsF() * hz - 1.0) > 0.05) {
+        timebase = base::TimeTicks();
+        interval = base::TimeDelta();
+    }
+#endif
+    if (interval.is_zero()) {
+        if (hz <= 1)
+            return;
+        interval = base::Seconds(1.0 / hz);
+    }
+    m_uiCompositor->SetDisplayVSyncParameters(timebase, interval);
+}
