+// TIGEREST_WEBENGINE_SHADER_CACHE names a directory for Chromium's GPU program
+// caches (ANGLE program binaries and Skia shaders). Without one every start
+// compiles the shaders again, and each link holds the GPU thread for tens of
+// milliseconds the first time an effect is drawn.
+static base::FilePath shaderCacheDirectory(const char *name)
+{
+    const QString root = qEnvironmentVariable("TIGEREST_WEBENGINE_SHADER_CACHE");
+    return root.isEmpty() ? base::FilePath() : toFilePath(root).AppendASCII(name);
+}
+
+base::FilePath ContentBrowserClientQt::GetShaderDiskCacheDirectory()
+{
+    return shaderCacheDirectory("ShaderCache");
+}
+
+base::FilePath ContentBrowserClientQt::GetGrShaderDiskCacheDirectory()
+{
+    return shaderCacheDirectory("GrShaderCache");
+}
