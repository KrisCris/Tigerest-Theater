+void NativeSkiaOutputDeviceDirect3D11::disableFenceSync(const char *reason, HRESULT hr)
+{
+    m_fenceSync = false;
+    if (!m_fenceFailed.exchange(true))
+        qWarning("Tigerest D3D11 fence sync disabled: %s (0x%08lx); using the CPU producer wait",
+                 reason, static_cast<unsigned long>(hr));
+}
+
+bool NativeSkiaOutputDeviceDirect3D11::ensureProducerFence()
+{
+    if (m_producerFence)
+        return true;
+    auto device = gl::QueryD3D11DeviceObjectFromANGLE();
+    HRESULT hr = device ? device.As(&m_producerDevice) : E_NOINTERFACE;
+    Microsoft::WRL::ComPtr<ID3D11DeviceContext> context;
+    if (SUCCEEDED(hr)) {
+        m_producerDevice->GetImmediateContext(&context);
+        hr = context.As(&m_producerContext);
+    }
+    Microsoft::WRL::ComPtr<ID3D11Fence> fence;
+    if (SUCCEEDED(hr))
+        hr = m_producerDevice->CreateFence(0, D3D11_FENCE_FLAG_SHARED, IID_PPV_ARGS(&fence));
+    HANDLE handle = nullptr;
+    if (SUCCEEDED(hr))
+        hr = fence->CreateSharedHandle(nullptr, GENERIC_ALL, nullptr, &handle);
+    if (FAILED(hr)) {
+        m_producerContext.Reset();
+        m_producerDevice.Reset();
+        disableFenceSync("producer fence unavailable", hr);
+        return false;
+    }
+    {
+        QMutexLocker locker(&m_fenceMutex);
+        m_producerFenceHandle = handle;
+    }
+    m_producerFence = fence;
+    qInfo("Tigerest D3D11 fence sync: producer fence ready");
+    return true;
+}
+
+void NativeSkiaOutputDeviceDirect3D11::willPresentBuffer(Buffer *buffer)
+{
+    buffer->producedFenceValue = 0;
+    if (!m_fenceSync)
+        return;
+    // Submit ANGLE's commands for this frame, then mark their completion.
+    glFlush();
+    HRESULT hr = m_producerContext->Signal(m_producerFence.Get(), m_producerValue + 1);
+    if (FAILED(hr)) {
+        disableFenceSync("producer signal failed", hr);
+        glFinish(); // This frame is published without a fence.
+        return;
+    }
+    m_producerContext->Flush();
+    buffer->producedFenceValue = ++m_producerValue;
+}
+
+void NativeSkiaOutputDeviceDirect3D11::willWriteBuffer(Buffer *buffer)
+{
+    const uint64_t value = std::exchange(buffer->releasedFenceValue, 0);
+    if (!value || !m_fenceSync || m_fenceFailed)
+        return;
+    HRESULT hr = S_OK;
+    if (!m_consumerFenceOnProducer) {
+        HANDLE handle = nullptr;
+        {
+            QMutexLocker locker(&m_fenceMutex);
+            handle = m_consumerFenceHandle;
+        }
+        hr = handle ? m_producerDevice->OpenSharedFence(handle, IID_PPV_ARGS(&m_consumerFenceOnProducer))
+                    : E_HANDLE;
+    }
+    // Qt's last read of this buffer precedes this write on the GPU.
+    if (SUCCEEDED(hr))
+        hr = m_producerContext->Wait(m_consumerFenceOnProducer.Get(), value);
+    if (FAILED(hr))
+        disableFenceSync("consumer fence wait failed", hr);
+}
+
+void NativeSkiaOutputDeviceDirect3D11::willReleaseFrontBuffer(Buffer *buffer)
+{
+    buffer->releasedFenceValue = 0;
+    if (!m_consumerFence || !m_fenceSync || m_fenceFailed)
+        return;
+    // Qt's frames that sampled this buffer were submitted to its immediate
+    // context at their frame ends, so this signal follows all of their reads.
+    HRESULT hr = m_consumerContext->Signal(m_consumerFence.Get(), m_consumerValue + 1);
+    if (FAILED(hr)) {
+        disableFenceSync("consumer signal failed", hr);
+        return;
+    }
+    m_consumerContext->Flush();
+    buffer->releasedFenceValue = ++m_consumerValue;
+}
