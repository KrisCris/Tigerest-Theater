+// Pixels scrolled per wheel line. Qt's generic step of 20 gives only 60px per
+// notch at the default three lines, which feels sluggish once the scroll
+// animator is on; Windows uses 50 (150px per notch, Chrome uses 100px).
+static float wheelScrollStep()
+{
+    static const float step = [] {
+        bool ok = false;
+        const float custom = qEnvironmentVariable("TIGEREST_WEBENGINE_WHEEL_STEP").toFloat(&ok);
+        if (ok && custom > 0)
+            return custom;
+#if defined(Q_OS_WIN)
+        return 50.f;
+#else
+        return 20.f;
+#endif
+    }();
+    return step;
+}
